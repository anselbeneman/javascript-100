{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javascript-100-ansel.vercel.app/schemas/project.schema.json",
  "title": "JavaScript 100 Project Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "description",
    "category",
    "status",
    "difficulty",
    "tech"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/project.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 80
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "In Progress",
        "Complete"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Intermediate",
        "Advanced",
        "Expert"
      ]
    },
    "tech": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
